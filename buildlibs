MAKE="make CC=$CLANG ALLOW_AUTHORIZED_LE=1"

if test 1 -eq 1
then
############ dynamic library ############
$MAKE clean
$MAKE TARGET=Z14

rm -f libopenblas*.a
mv libopenblas.dll libopenblas_z14-r0.3.13.dev_zOS_64xp.dll
mv libopenblas_z14-r0.3.13.dev.a.x libopenblas_z14-r0.3.13.dev_zOS_64xp.x
mv libopenblas* lib_dynamic
cd lib_dynamic
ln -s libopenblas_z14-r0.3.13.dev_zOS_64xp.dll libopenblas.dll
ln -s libopenblas_z14-r0.3.13.dev_zOS_64xp.x libopenblas.x
cd ..
########################################
fi

#

if test 1 -eq 1
then
############ static library ############
$MAKE clean
$MAKE NO_SHARED=1 TARGET=Z14

rm -f libopenblas.a
mv libopenblas_z14-r0.3.13.dev.a libopenblas_z14-r0.3.13.dev_zOS_64xp.a
mv libopenblas* lib_static
cd lib_static
ln -s libopenblas_z14-r0.3.13.dev_zOS_64xp.a libopenblas.a
cd ..
########################################
fi
